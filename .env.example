# ============================================================
# Propheteia Backend - Environment Configuration
# Copy this file to `.env` and adjust the values.
# ============================================================

# ---- Server -------------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# ---- Logging ------------------------------------------------
# Levels: debug | info | warn | error
LOG_LEVEL=info
# Optional file log target (relative to project root or absolute)
LOG_FILE=

# ---- Caching ------------------------------------------------
# Backend for the weather response cache:
#   memory | sqlite | both
CACHE_BACKEND=memory
# Entry lifetime in seconds (weather responses)
CACHE_TTL_SECONDS=600

# ---- Persistence --------------------------------------------
# SQLite database file (holds recursive FFMC/DMC/DC state,
# weather cache and monitored locations)
DB_PATH=./data/propheteia.db

# ---- Weather provider (Open-Meteo) --------------------------
OPEN_METEO_BASE_URL=https://api.open-meteo.com
OPEN_METEO_TIMEOUT_MS=8000

# ---- Reverse geocoding (Photon + Nominatim fallback) --------
# Used to name prediction points ("Near Agadir", "In Lisbon").
# Free and keyless; no paid licence required. Nominatim only kicks in
# when Photon has no data for a coordinate, at 1 req/s max.
REVERSE_GEOCODE_BASE_URL=https://photon.komoot.io
REVERSE_GEOCODE_TIMEOUT_MS=8000
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_TIMEOUT_MS=8000
NOMINATIM_USER_AGENT=propheteia-backend/1.0 (wildfire-risk monitoring; https://github.com/Tawfik404/Propheteia)

# ---- Background jobs ----------------------------------------
# Set to false to disable the cron scheduler
JOBS_ENABLED=true

# ---- FWI System startup values ------------------------------
# Values used when no previous day state exists for a location
# (Van Wagner 1987 springtime recommendations)
FWI_START_FFMC=85
FWI_START_DMC=6
FWI_START_DC=15

# ---- Land-cover terrain filtering ---------------------------
# Wildfire predictions are only generated where the land-cover map
# confirms combustible vegetation (no water, ice, bare desert or
# vegetation-free urban cores).
#
# Provider chain, tried in order for every classification:
#   worldcover | osm | mask
#   worldcover: ESA WorldCover 2021 satellite map (primary, cached)
#   osm:        OpenStreetMap land-use via Overpass (fallback)
#   mask:       coarse static land/water mask (last resort; only
#               active when LAND_COVER_ALLOW_MASK_FALLBACK=true)
LAND_COVER_PROVIDERS=worldcover,osm
# Classification cache lifetime in days (land cover changes yearly)
LAND_COVER_CACHE_TTL_DAYS=30
# Minimum vegetation coverage (%) for a prediction to be generated
LAND_COVER_MIN_VEGETATION_PCT=40
# Lower edge of the "optional" vegetation band (%); below this = skip
LAND_COVER_OPTIONAL_MIN_PCT=20
# Whether the 20-40% optional band also generates predictions
LAND_COVER_ALLOW_OPTIONAL=false
# Sample radius (m) around a point used to estimate vegetation coverage
LAND_COVER_SAMPLE_RADIUS_M=1000
LAND_COVER_SAMPLE_MIN_RADIUS_M=60
LAND_COVER_SAMPLE_MAX_RADIUS_M=2000
# Whether the static land mask may stand in when all providers fail
LAND_COVER_ALLOW_MASK_FALLBACK=false

# ESA WorldCover 2021 COG tile server (public ESA S3 bucket)
WORLD_COVER_BASE_URL=https://esa-worldcover.s3.eu-central-1.amazonaws.com/v200/2021/map
WORLD_COVER_TIMEOUT_MS=20000
WORLD_COVER_CONCURRENCY=4
WORLD_COVER_RETRIES=2

# OpenStreetMap Overpass fallback provider
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
OSM_OVERPASS_TIMEOUT_MS=15000
