# ============================================================
# Propheteia Backend - Environment Configuration
# Copy this file to `.env` and adjust the values.
# ============================================================

# ---- Server -------------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# ---- Logging ------------------------------------------------
# Levels: debug | info | warn | error
LOG_LEVEL=info
# Optional file log target (relative to project root or absolute)
LOG_FILE=

# ---- Caching ------------------------------------------------
# Backend for the weather response cache:
#   memory | sqlite | both
CACHE_BACKEND=memory
# Entry lifetime in seconds (weather responses)
CACHE_TTL_SECONDS=600

# ---- Persistence --------------------------------------------
# SQLite database file (holds recursive FFMC/DMC/DC state,
# weather cache and monitored locations)
DB_PATH=./data/propheteia.db

# ---- Weather provider (Open-Meteo) --------------------------
OPEN_METEO_BASE_URL=https://api.open-meteo.com
OPEN_METEO_TIMEOUT_MS=8000

# ---- Background jobs ----------------------------------------
# Set to false to disable the cron scheduler
JOBS_ENABLED=true

# ---- FWI System startup values ------------------------------
# Values used when no previous day state exists for a location
# (Van Wagner 1987 springtime recommendations)
FWI_START_FFMC=85
FWI_START_DMC=6
FWI_START_DC=15
